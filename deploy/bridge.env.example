# /etc/personal-assistant/bridge.env  (root:bridge, mode 640)
# Values come from 1Password. Never commit the real file.

WA_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
WA_PHONE_NUMBER_ID=1310849255447468
GRAPH_VERSION=v23.0

# E.164 digits, no plus sign
ALLOWED_WA_ID=
# Business-scoped user id from the webhook contact object; optional until known
ALLOWED_USER_ID=

VAULT_DIR=/srv/vault
GIT_DIR=/srv/vault-git
MEDIA_DIR=_assets/whatsapp
GIT_PUSH=true

CLAUDE_RUN=/home/assistant/bin/claude-run
CLAUDE_USER=assistant
CLAUDE_TIMEOUT=10m

DB_PATH=/var/lib/personal-assistant/bridge.db
LISTEN=127.0.0.1:8080

# Scheduled jobs (POST /jobs/<name> from loopback; see deploy/jobs/ and the timers)
JOBS_DIR=/etc/personal-assistant/jobs
JOB_TZ=America/Monterrey
# Approved utility template with one body parameter, used when a proactive
# message falls outside the 24-hour window. Leave empty until it is approved.
WA_TEMPLATE=assistant_update
WA_TEMPLATE_LANG=en_US
